# Copie este arquivo para .env e ajuste os valores.
# O .env está no .gitignore e NUNCA deve ser comitado.

# --- Banco de dados ---
# Opção A: Postgres local via Docker Compose (desenvolvimento)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/espacos

# Opção B: Supabase (demonstração / produção)
# Use a connection string do POOLER (Transaction), porta 6543, com SSL.
# Encontre em: Supabase > Project Settings > Database > Connection string > Transaction pooler
# DATABASE_URL=postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?sslmode=require

# --- Servidor ---
PORT=3001

# Força SSL manualmente, se necessário (a detecção automática já cobre a Supabase).
# PGSSL=true

# Recria o schema e o seed a cada inicialização (útil no início do desenvolvimento).
# SEED_ON_START=true
