{
  "name": "espacos-corporativos",
  "version": "1.0.0",
  "description": "Sistema Inteligente de Gestão e Otimização de Espaços Corporativos (MVP frontend)",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
